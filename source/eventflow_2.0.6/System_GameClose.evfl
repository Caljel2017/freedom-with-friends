# Freedom with Friends — ACNH 2.0.6 Minus menu
# Base: ACNH-Tutorial-Skip-ref System_GameClose (modern / 2.0.x)
# Adds: save unlock, Profile (name+birthday), Airport warp, session unlocks
# Labels: TalkSys/SYS_CloseMenu overlay (020 Freedom / Save; 021 Profile / Airport)

flow DreamClose():
	EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:028', false)
	switch EventFlowSystemActor.GeneralTalkChoice3():
		case 0:
			EventFlowSystemActor.MessageSuspend()
			run SNPC_tap_02_InDreaming::Jumpup()
		case 1:
			if EventFlowSystemActor.NetIsPublicDream():
				EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:027', true)
			else:
				run ReportDream()
		default:
			return

flow LocalClose():
	if EventFlowSystemActor.NetIsInviteFriend():
		EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:001', true)
		if EventFlowSystemActor.GeneralTalkChoice2() != 0:
			EventFlowSystemActor.UIShopMoneyDisappear()
			EventFlowSystemActor.UIMenuProfileOthersHandling()
		elif EventFlowSystemActor.NetCanRequestLeave():
			run RetryLock()
		else:
			EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:007', false)
	else:
		EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:004', true)
		if EventFlowSystemActor.GeneralTalkChoice2() != 0:
			EventFlowSystemActor.UIShopMoneyDisappear()
			EventFlowSystemActor.UIMenuProfileOthersHandling()
		elif EventFlowSystemActor.NetCanRequestLeave():
			EventFlowSystemActor.MessageLockNext(1)
			EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_Network:005', false)
			EventFlowSystemActor.NetDemoLock(1)
			EventFlowSystemActor.MessageUnlockNext()
			if EventFlowSystemActor.CheckErrorType(2):
				EventFlowSystemActor.MessageLockNext(2)
				EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_Network:007', false)
				EventFlowSystemActor.NetForceQuitSession()
				EventFlowSystemActor.MessageUnlockNext()
				EventFlowSystemActor.MessageSuspend()
				if not EventFlowSystemActor.MessageUseBCancel():
					EventFlowSystemActor.NetLeaveSessionVillage('cLeaveSession', false)
			else:
				EventFlowSystemActor.MessageSuspend()
				EventFlowSystemActor.NetLeaveSessionVillage('cLeaveSession', false)
		else:
			EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:007', false)

flow NetClose():
	if EventFlowSystemActor.NetMode() in (0, 1):
		run LocalClose()
	else:
		run System_InetClose::InetClose()

flow ReportDream():
	EventFlowSystemActor.MessageSuspend()
	EventFlowSystemActor.NetCaptureScreenshot()
	EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:025', false)
	if EventFlowSystemActor.GeneralTalkChoice2() == 0:
		EventFlowSystemActor.UIIllegalReportHandling(8)
		if EventFlowSystemActor.UIIllegalReportResult():
			EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:026', true)
			EventFlowSystemActor.MiniGameSilentCancel()
			EventFlowSystemActor.StopMeasurePlayTime('cDreaming')
			EventFlowSystemActor.FadeOut('', '', 'cBlack', 1.0, 1.0, true)
			EventFlowSystemActor.NetExitDream(true)
			EventFlowSystemActor.SystemRequestChangeStage('cDreamDemo', 'cDream', 'cDream', 'cBlack', 1.0, 1.0)

flow RetryLock():
	EventFlowSystemActor.MessageLockNext(1)
	EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_Network:006', false)
	EventFlowSystemActor.NetDemoLock(2)
	EventFlowSystemActor.MessageUnlockNext()
	if EventFlowSystemActor.CheckErrorType(2):
		EventFlowSystemActor.MessageLockNext(2)
		EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_Network:008', false)
		EventFlowSystemActor.NetForceQuitSession()
		EventFlowSystemActor.MessageUnlockNext()
		EventFlowSystemActor.MessageSuspend()
		if not EventFlowSystemActor.MessageUseBCancel():
			EventFlowSystemActor.NetBreakUpSessionVillage('cBreakUpSession', false)
	else:
		EventFlowSystemActor.MessageSuspend()
		EventFlowSystemActor.NetBreakUpSessionVillage('cBreakUpSession', false)

flow Root():
	if EventFlowSystemActor.NetIsConnected():
		if EventFlowSystemActor.IsMyVillage():
			if EventFlowSystemActor.NetHasVisitor():
				run NetClose()
			else:
				run Sub_grp_Event24()
		else:
			run NetClose()
	else:
		run Sub_grp_Event24()

local flow DoSaveAndEnd():
	if EventFlowSystemActor.NetIsInviteFriend():
		EventFlowSystemActor.NetEndSessionVillage('cEndVillageSession', true)
	EventFlowSystemActor.ReserveSystemFlowDemo('System_SaveGameClose', 'Root', false, false, false)
	EventFlowSystemActor.SystemRequestChangeStage('cSaveGameClose', 'cCircle', 'cCircle', 'cBlack', 1.0, 1.0)

local flow EditNameAndBirthday():
	EventFlowSystemActor.SoundDuckingOn(41)
	EventFlowSystemActor.UISoftwareKeyboardHandling('cName', true)
	EventFlowSystemActor.SoundDuckingOff(41)
	EventFlowSystemActor.SaveSetFromUIResult('cPlayerName')
	EventFlowSystemActor.SetTagFromUIResult('cPlayerNameNoGender', 0)
	EventFlowSystemActor.UIDateHandling('cOpeningBirthday')
	EventFlowSystemActor.SaveSetFromUIResult('cBirthDay')

# Warp to airport apron / Orville area (same stage Tutorial Skip uses after landing).
local flow GoToAirport():
	EventFlowSystemActor.FadeOut('cCircle', 'cCircle', 'cBlack', 1.0, 1.0, true)
	EventFlowSystemActor.SystemRequestChangeStage('cFrontOfAirPort', 'cCircle', 'cCircle', 'cBlack', 1.0, 1.0)

# Freedom hub — Profile / Airport (labels via Message overlay).
flow FreedomMenu():
	run ApplyFreedomUnlocks()
	EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:021', false)
	switch EventFlowSystemActor.GeneralTalkChoice2():
		case 0:
			run EditNameAndBirthday()
		case 1:
			run GoToAirport()

local flow ApplyFreedomUnlocks():
	System.EventFlags['cPlayer:ValidatePlayerSaveFlag'] = true
	System.EventFlags['cLand:ValidateVillageSave'] = true
	System.EventFlags['cPlayer:EnableEmoticonUI'] = true
	System.EventFlags['cPlayer:EnablePcTownDecoration'] = true
	System.EventFlags['cLand:AirportOpen'] = true
	System.EventFlags['cPlayer:OdekakeFirstTalk'] = true
	System.EventFlags['cPlayer:OdekakeTutorial'] = true
	System.EventFlags['cPlayer:PcMaingameStart'] = true
	System.EventFlags['cPlayerTemp:DodTalkSceneFlag'] = true
	System.EventFlags['cLand:VillageDaysCount'] = 3
	System.EventFlags['cPlayer:PlayerMainUImenuEnable'] = true
	System.EventFlags['cPlayer:PlayerEnableEating'] = true
	System.EventFlags['cPlayer:MainUiClockEnable'] = true
	System.EventFlags['cPlayer:MainmenuEncyclopedia'] = true
	System.EventFlags['cPlayer:MainmenuCall'] = true
	System.EventFlags['cPlayer:MainmenuMap'] = true
	System.EventFlags['cPlayer:MainmenuMydesign'] = true
	System.EventFlags['cPlayer:MainmenuBank'] = true
	System.EventFlags['cPlayer:MainmenuOnlineShopping'] = true
	System.EventFlags['cPlayer:MainmenuAchievement'] = true
	System.EventFlags['cPlayer:MainmenuFriendList'] = true
	System.EventFlags['cPlayer:FriendListMainSwitch'] = true
	System.EventFlags['cPlayer:MainmenuChatLog'] = true
	System.EventFlags['cPlayer:MainmenuTips'] = true
	System.EventFlags['cPlayer:MainmenuConstructLicense'] = true
	System.EventFlags['cPlayer:GetLicenseRiver'] = true
	System.EventFlags['cPlayer:GetLicenseCliff'] = true
	System.EventFlags['cPlayer:Activate_WebService'] = true
	System.EventFlags['cPlayer:UpgradePocket30'] = true
	System.EventFlags['cPlayer:UpgradePocket40'] = true
	# Emote wheel UI + gymnastics set (full villager reaction list needs NHSE / mapped IDs).
	EventFlowSystemActor.GetGymnasticsEmoticon()

local flow Sub_grp_Event24():
	# Save unlocked (ValidatePlayerSaveFlag gate removed).
	run ApplyFreedomUnlocks()
	if EventFlowSystemActor.SystemCheckNowStage('cCheckStageSymbol00'):
		run System_WherearenClose::WherearenClose()
	elif EventFlowSystemActor.NetIsDreaming():
		run DreamClose()
	elif (EventFlowSystemActor.SystemCheckNowStage('cCheckStageSymbol01')) or (System.EventFlags['cLandTemp:JuneBrideCeremonyDemoAfterNow']) or (EventFlowSystemActor.IsPlayerBirthdayRoom()) or ((EventFlowSystemActor.SystemCheckNowStage('cAnyNpcHouse')) and (System.EventFlags['cLandTemp:NpcInteriorCoordinate'])):
		EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:019', false)
	elif EventFlowSystemActor.IsSharePlay(1):
		run System_SharePlay_Entry::ExitSharePlay()
	else:
		# :020 — Freedom / Save and end
		EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:020', false)
		switch EventFlowSystemActor.GeneralTalkChoice2():
			case 0:
				run FreedomMenu()
			case 1:
				run DoSaveAndEnd()
