# Freedom with Friends — ACNH 2.0.6 Minus (minimal, Yuzu-safe)
# No Message overlay. No external EventFlow calls (Wherearen/SharePlay/InetClose).
# Choice2 only on vanilla TalkSys/SYS_CloseMenu:020.

flow Root():
	System.EventFlags['cPlayer:ValidatePlayerSaveFlag'] = true
	System.EventFlags['cLand:ValidateVillageSave'] = true
	# Visitor on someone else's island: one-time tent claim as first choice.
	if (EventFlowSystemActor.NetIsConnected()) and (not EventFlowSystemActor.IsMyVillage()) and (not System.EventFlags['cPlayerTemp:CampInviteRejected']):
		EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:020', false)
		switch EventFlowSystemActor.GeneralTalkChoice2():
			case 0:
				System.EventFlags['cPlayer:UpgradePocket30'] = true
				System.EventFlags['cPlayer:UpgradePocket40'] = true
				EventFlowSystemActor.SetItemToPocket(2750, 1)
				System.EventFlags['cPlayerTemp:CampInviteRejected'] = true
			case 1:
				return
	else:
		EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:020', false)
		switch EventFlowSystemActor.GeneralTalkChoice2():
			case 0:
				run DoSaveAndEnd()
			case 1:
				run FreedomHub()

local flow DoSaveAndEnd():
	if EventFlowSystemActor.NetIsInviteFriend():
		EventFlowSystemActor.NetEndSessionVillage('cEndVillageSession', true)
	EventFlowSystemActor.ReserveSystemFlowDemo('System_SaveGameClose', 'Root', false, false, false)
	EventFlowSystemActor.SystemRequestChangeStage('cSaveGameClose', 'cCircle', 'cCircle', 'cBlack', 1.0, 1.0)

flow FreedomHub():
	System.EventFlags['cPlayer:EnableEmoticonUI'] = true
	System.EventFlags['cPlayer:EnablePcTownDecoration'] = true
	System.EventFlags['cLand:AirportOpen'] = true
	System.EventFlags['cPlayer:OdekakeFirstTalk'] = true
	System.EventFlags['cPlayer:OdekakeTutorial'] = true
	System.EventFlags['cPlayer:PcMaingameStart'] = true
	System.EventFlags['cPlayer:PlayerMainUImenuEnable'] = true
	System.EventFlags['cPlayer:MainmenuConstructLicense'] = true
	System.EventFlags['cPlayer:GetLicenseRiver'] = true
	System.EventFlags['cPlayer:GetLicenseCliff'] = true
	System.EventFlags['cPlayer:UpgradePocket30'] = true
	System.EventFlags['cPlayer:UpgradePocket40'] = true
	EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:013', false)
	EventFlowSystemActor.OpenMessageWindow('TalkSys/SYS_CloseMenu:020', false)
	switch EventFlowSystemActor.GeneralTalkChoice2():
		case 0:
			EventFlowSystemActor.FadeOut('cCircle', 'cCircle', 'cBlack', 1.0, 1.0, true)
			EventFlowSystemActor.SystemRequestChangeStage('cFrontOfAirPort', 'cCircle', 'cCircle', 'cBlack', 1.0, 1.0)
		case 1:
			EventFlowSystemActor.SoundDuckingOn(41)
			EventFlowSystemActor.UISoftwareKeyboardHandling('cName', true)
			EventFlowSystemActor.SoundDuckingOff(41)
			EventFlowSystemActor.SaveSetFromUIResult('cPlayerName')
			EventFlowSystemActor.SetTagFromUIResult('cPlayerNameNoGender', 0)
			EventFlowSystemActor.UIDateHandling('cOpeningBirthday')
			EventFlowSystemActor.SaveSetFromUIResult('cBirthDay')
